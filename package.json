{
  "name": "nhom7-thuyet-trinh",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "e2e": "playwright test",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "content": "python3 scripts/extract-content.py && prettier --write src/content/slides.ts src/content/sources.ts",
    "format": "prettier --write src tests e2e scripts/*.mjs *.ts *.json index.html README.md THIRD_PARTY_NOTICES.md"
  },
  "dependencies": {
    "@mediapipe/hands": "0.4.1675469240",
    "framer-motion": "14.2.0",
    "lucide-react": "1.57.0",
